{
  "manifest_version": 3,
  "name": "paperline",
  "version": "1.4.0",
  "description": "A calm, precise PDF workspace. Add and edit text boxes, highlight, draw, and save. Everything stays on your device.",
  "minimum_chrome_version": "128",
  "permissions": ["activeTab", "contextMenus", "storage", "downloads", "declarativeNetRequestWithHostAccess", "webNavigation", "webRequest", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*", "file:///*"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["pdf-links.js"], "run_at": "document_start", "all_frames": true }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{ "resources": ["index.html"], "matches": ["http://*/*", "https://*/*", "file:///*"] }],
  "action": { "default_title": "Open in Paperline", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'" }
}
